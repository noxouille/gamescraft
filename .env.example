# Environment Configuration (development or production)
ENVIRONMENT=development

# Development API Keys
OPENAI_API_KEY_DEV=your_openai_dev_key_here
TOGETHER_API_KEY_DEV=your_together_dev_key_here

# Development Models
OPENAI_MODEL_DEV=gpt-4o-mini
TOGETHER_MODEL_DEV=meta-llama/Llama-3-8b-chat-hf

# Production API Keys
OPENAI_API_KEY_PROD=your_openai_prod_key_here
TOGETHER_API_KEY_PROD=your_together_prod_key_here

# Production Models (typically more powerful/expensive)
OPENAI_MODEL_PROD=gpt-4
TOGETHER_MODEL_PROD=meta-llama/Llama-3-70b-chat-hf

# Request Configuration (applies to both environments)
MAX_RETRIES=3
TIMEOUT=30